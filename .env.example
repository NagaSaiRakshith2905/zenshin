# Copy to .env.local. All variables are server-only; keep secrets out of Git.

# Application (required): development | preview | production.
APP_ENV=development
# Canonical origin; HTTPS required outside development.
APP_ORIGIN=http://localhost:3000

# Database: pooled runtime connection and unpooled migration connection.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Tests only: local zenshin_test_runner with create/drop access; supply to test process.
TEST_DATABASE_URL=

# Owner login (required).
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Must match APP_ORIGIN.
BETTER_AUTH_URL=http://localhost:3000
# OAuth app: https://github.com/settings/applications/new
# Callback: <APP_ORIGIN>/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Numeric id from https://api.github.com/users/<USERNAME>, not the username.
OWNER_GITHUB_ID=

# Upstash Redis (REST): auth sessions and rate-limit counters.
# From the database's REST API section at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Future integrations: leave blank until implemented.

# After-request job limits.
JOBS_BATCH_LIMIT=
JOBS_TIME_BUDGET_MS=

# Private Cloudflare R2.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Comma-separated origins; also configure bucket CORS.
R2_CORS_ORIGINS=http://localhost:3000

# Repository GitHub App, separate from login OAuth: https://github.com/settings/apps/new
GITHUB_APP_ID=
# Full PEM contents; quoted \n escapes are supported in local env files.
GITHUB_APP_PRIVATE_KEY=
# Must match the secret configured in the App's webhook settings.
GITHUB_APP_WEBHOOK_SECRET=
# Slug from https://github.com/apps/<SLUG>
GITHUB_APP_SLUG=
# Installation callback; route to be defined when integration is implemented.
GITHUB_APP_CALLBACK_URL=

# Observability (provider pending).
ERROR_REPORTING_DSN=
OPERATIONAL_ALERT_EMAIL=

# Independent backup runner only; do not supply these to the app.
# Unpooled database dump connection.
BACKUP_DATABASE_URL=
# R2 source with separate read credentials.
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Independent encrypted S3 destination.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_KMS_KEY_ID=
# Backup failure and age alerts.
BACKUP_ALERT_EMAIL=
