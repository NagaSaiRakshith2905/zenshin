# Phase 1 runtime. Copy to .env.local; keep real values out of Git.
APP_ENV=development
APP_ORIGIN=http://localhost:3000

# Phase 2: isolated application and migration connections (server only).
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Tests only: local disposable database named zenshin_test_<unique run ID>.
TEST_DATABASE_URL=

# Phase 3: GitHub-only owner login (server only).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OWNER_GITHUB_ID=

# Phase 10: bounded authenticated jobs (server only).
CRON_SECRET=
JOBS_BATCH_LIMIT=
JOBS_TIME_BUDGET_MS=

# Phase 11: private R2 (server only; separate preview/production buckets).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CORS_ORIGINS=http://localhost:3000

# Phase 12: repository integration, separate from login (server only).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=

# Observability (server only; provider selection/provisioning pending).
ERROR_REPORTING_DSN=
OPERATIONAL_ALERT_EMAIL=

# Phase 15: independent backup runner ONLY. Do not supply these to the app.
BACKUP_DATABASE_URL=
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_KMS_KEY_ID=
BACKUP_ALERT_EMAIL=
# Retention/scheduling/age monitoring are runner configuration, documented in docs/ENVIRONMENT.md.

# No NEXT_PUBLIC_* variables are needed. No credential belongs in a browser bundle.
